{
  "name": "aoiko",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/copy-tesseract-assets.js",
    "dev": "vite",
    "prebuild": "node scripts/copy-tesseract-assets.js",
    "build": "vite build",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --silent",
    "check": "npm run paraglide:compile && svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test": "npm run paraglide:compile && vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run licenses:check && npm run format:check && npm run check && npm run test && npm run build",
    "xtx:build-schema": "node scripts/build-xtx-schema.js",
    "licenses:generate": "node scripts/gen-third-party-licenses.js",
    "licenses:check": "node scripts/gen-third-party-licenses.js --check",
    "tauri": "tauri",
    "init:bundle": "esbuild src-init/index.js --bundle --format=iife --target=safari16 --outfile=src-tauri/init.js",
    "tauri:dev": "npm run init:bundle && tauri dev",
    "tauri:build": "npm run init:bundle && node scripts/build-frontend.mjs && tauri build",
    "ios:prepare": "node scripts/prepare-ios.mjs",
    "ios:dev": "npm run init:bundle && npm run ios:prepare && tauri ios dev",
    "ios:build": "npm run init:bundle && npm run ios:prepare && node scripts/build-frontend.mjs && tauri ios build",
    "test:init": "node --test \"src-init/*.test.js\"",
    "test:rust": "npm run init:bundle && cargo test --manifest-path src-tauri/Cargo.toml -p aoiko-desktop -p tauri-plugin-aoiko-native",
    "check:ios": "IPHONEOS_DEPLOYMENT_TARGET=16.4 cargo check --target aarch64-apple-ios --manifest-path src-tauri/Cargo.toml -p tauri-plugin-aoiko-native -p aoiko-desktop",
    "licenses:native:generate": "node scripts/gen-native-licenses.mjs",
    "licenses:native:check": "node scripts/gen-native-licenses.mjs --check"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.23.1",
    "@inlang/plugin-message-format": "^4.4.1",
    "@internationalized/date": "^3.12.3",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2.11.4",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/encoding-japanese": "^2.2.1",
    "@types/node": "^26.2.0",
    "@vitest/ui": "^4.1.10",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "fast-xml-parser": "^5.10.1",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "shadcn-svelte": "^1.5.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "dexie": "^4.4.3",
    "encoding-japanese": "^2.2.0",
    "fflate": "^0.8.3",
    "marked": "^18.0.9",
    "tesseract-wasm": "^0.11.0"
  }
}
