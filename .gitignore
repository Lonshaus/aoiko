# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
dev-dist/

# Vite / Vitest cache & coverage
.vite/
coverage/

# Paraglide compiled output（messages/ から自動生成）
src/paraglide/

# tesseract.js の worker / コア（node_modules から自動複製）
public/tesseract/

# 環境変数
.env
.env.*
!.env.example

# TypeScript
*.tsbuildinfo

# Vite/Vitest ローカル上書き
*.local

# Playwright（Phase 4）
playwright/.cache/

# Editor
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln

# OS
.DS_Store
Thumbs.db

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ネイティブ側（Tauri）のビルド生成物
src-tauri/target/
# 入れ子のクレートで cargo を走らせた時の置き土産も拾う
**/target/
# ライブラリクレートの Cargo.lock は追跡しない（入れ子で cargo を走らせると出来る）
src-tauri/plugins/*/Cargo.lock
src-tauri/gen/
# esbuild が src-init/ から生成する。
src-tauri/init.js
# tauri ios build がプラグインへ複製する Tauri の Swift API。
src-tauri/plugins/*/.tauri/

# aoiko 手動 export（誤コミット防止）
aoiko-ledger-*.json
aoiko-*.xtx
