{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aoiko",
  "version": "1.0.0",
  "identifier": "net.lonshaus.aoiko",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:10708",
    "beforeDevCommand": "npm run dev:native"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "個人事業主向けの青色申告記帳ツール",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "iOS": {
      "minimumSystemVersion": "16.4"
    },
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist",
      "files": {
        "Resources/PrivacyInfo.xcprivacy": "PrivacyInfo.xcprivacy"
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
